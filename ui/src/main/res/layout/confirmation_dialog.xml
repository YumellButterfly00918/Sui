<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:minHeight="520dp"
    android:elevation="8dp"
    android:background="@drawable/confirmation_dialog_background"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp"
    tools:background="@drawable/confirmation_dialog_background">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:importantForAccessibility="no"
            android:tint="@color/permission_dialog_text"
            android:tintMode="src_in"
            tools:src="@drawable/ic_su_24" />

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/permission_request_title"
            android:textColor="@color/permission_dialog_text"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Permission Request" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:textColor="@color/permission_dialog_secondary_text"
            android:textSize="16sp"
            tools:text="Allow App Name to use Shizuku?" />

        <Button
            android:id="@android:id/button1"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/confirmation_button_blue"
            android:gravity="center"
            android:minHeight="52dp"
            android:padding="12dp"
            android:textAllCaps="false"
            android:textColor="@color/permission_dialog_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Allow all the time"
            tools:textColor="@color/confirmation_dialog_button_text" />

        <Button
            android:id="@android:id/button2"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/confirmation_button_blue"
            android:gravity="center"
            android:minHeight="52dp"
            android:padding="12dp"
            android:textAllCaps="false"
            android:textColor="@color/permission_dialog_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Only this time"
            tools:textColor="@color/confirmation_dialog_button_text" />

        <Button
            android:id="@android:id/button3"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/confirmation_button_red"
            android:gravity="center"
            android:minHeight="52dp"
            android:padding="12dp"
            android:textAllCaps="false"
            android:textColor="@color/permission_dialog_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Deny"
            tools:textColor="@color/confirmation_dialog_button_text" />

</LinearLayout>
